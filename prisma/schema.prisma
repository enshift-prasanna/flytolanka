// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Category model
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String?   @unique
  name        String
  description String
  image       String?
  defaultText String?
  packages    Package[]
}

// Package model
model Package {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  slug                String?  @unique
  title               String
  categoryId          String
  days                String
  price               String?
  pricingTiers        Json?
  shortDescription    String
  detailedDescription String
  image               String?
  category            Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}


// Blog model
model Blog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String?  @unique
  title     String
  excerpt   String
  content   String
  image     String?
  createdAt DateTime @default(now())
}

// ThingsToDo model (copy of Blog)
model ThingsToDo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String?  @unique
  title     String
  excerpt   String
  content   String
  image     String?
  createdAt DateTime @default(now())
}

// Vehicle model
model Vehicle {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  image String?
}

// Booking model
model Booking {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingRef     String   @unique
  clerkUserId    String?
  customerName   String
  customerEmail  String
  customerPhone  String
  country        String?
  packageId      String?
  packageName    String
  arrivalDate    String
  departureDate  String?
  adults         Int
  children       Int      @default(0)
  infants        Int      @default(0)
  adultTotal     Float?
  kidTotal       Float?
  infantTotal    Float?
  totalPrice     Float?
  status         String   @default("PENDING")
  specialNotes   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clerkUserId])
  @@index([customerEmail])
}
